parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc tag @var with type string\|false is not subtype of native type string\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/content/SeekableFileContent.php

		-
			message: '#^PHPDoc tag @var with type string\|false is not subtype of native type string\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/content/StringBasedFileContent.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/vfsStream.php
